# Copy to .env.deploy on the server (never commit it) and fill in:
#   docker compose -f docker-compose.minimal.yaml --env-file .env.deploy --profile tunnel up -d
# Cloudflare: Zero Trust > Networks > Tunnels > your tunnel > the token in the install command.
TUNNEL_TOKEN=
# Postgres inside the compose network (not reachable from outside); any long random string.
POSTGRES_PASSWORD=
